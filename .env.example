# Application
ENVIRONMENT=development
APP_NAME=PaperMind
API_PREFIX=/api
APP_API_KEY=change-me
FRONTEND_ORIGIN=http://localhost:3000
API_URL=http://localhost:8000/api

# PostgreSQL / Redis
POSTGRES_DB=papermind
POSTGRES_USER=papermind
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://papermind:change-me@postgres:5432/papermind
REDIS_URL=redis://redis:6379/0

# Files and PDF processing
DATA_ROOT=/data
MAX_UPLOAD_MB=100
GROBID_URL=http://grobid:8070
GROBID_TIMEOUT_SECONDS=180
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# Zotero metadata sync (PDFs are never fetched from Zotero storage)
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user

# Replaceable AI providers
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

